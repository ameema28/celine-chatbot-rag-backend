# Celine Esthetique AI Backend - environment template
# Copy to .env and fill in real values. Never commit .env.

# LLM (Groq). Without a usable key the API runs in offline fallback mode.
# A value starting with "your_" is treated as a placeholder (offline mode).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-20b

# Embeddings (local sentence-transformers model)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: SQLite session file location (default: sessions.db in the project root)
# SESSIONS_DB_PATH=./sessions.db

# Optional app metadata
# PROJECT_NAME=Celine Esthetique Luxury AI Backend
# VERSION=1.0.0
