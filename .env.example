# Celine Esthetique AI Backend - environment template
# Copy to .env and fill in real values. Never commit .env.

# LLM (Groq). Without a usable key the API runs in offline fallback mode.
# A value starting with "your_" is treated as a placeholder (offline mode).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-20b

# Embeddings (local sentence-transformers model)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: FAISS relevance cutoff (squared L2 distance; lower = stricter).
# Retrieved salon entries farther than this are ignored.
# RAG_MAX_L2_DISTANCE=1.20

# Browser origins allowed to call the API (comma-separated). file:// pages send
# "Origin: null" and are not allowed: serve demo.html with `python -m http.server 5500`.
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500

# Rate limiting (10 requests/min per client IP). Set to true ONLY behind a reverse
# proxy you control: the first X-Forwarded-For entry is then used as the client IP.
# Without it, all users behind a proxy share the proxy's IP (one shared limit).
# TRUST_PROXY=false

# Optional: SQLite session file location (default: sessions.db in the project root)
# SESSIONS_DB_PATH=./sessions.db

# Optional app metadata
# PROJECT_NAME=Celine Esthetique Luxury AI Backend
# VERSION=1.0.0
